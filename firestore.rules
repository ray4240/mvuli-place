rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }

    function validInquiry() {
      return request.resource.data.keys().hasAll([
          'name', 'phone', 'email', 'unitTypology', 'message', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'unitTypology', 'message', 'createdAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.unitTypology in [
          'Studio', '1BR-A', '1BR-B', '1BR-C', '1BR-D', 'Not sure'
        ] &&
        request.resource.data.createdAt == request.time;
    }

    function validProgress() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'overallPercent', 'summary', 'estimatedCompletion', 'milestones', 'photos', 'updatedAt'
        ]) &&
        d.overallPercent is number &&
        d.overallPercent >= 0 && d.overallPercent <= 100 &&
        d.summary is string && d.summary.size() <= 600 &&
        d.estimatedCompletion is string && d.estimatedCompletion.size() <= 60 &&
        d.milestones is list && d.milestones.size() <= 20 &&
        d.photos is list && d.photos.size() <= 30 &&
        d.updatedAt == request.time;
    }

    function validProgressHistory(date) {
      let d = request.resource.data;
      return d.keys().hasOnly(['date', 'percent', 'milestones', 'updatedAt']) &&
        d.date is string && d.date == date && d.date.size() == 10 &&
        d.percent is number && d.percent >= 0 && d.percent <= 100 &&
        d.milestones is list && d.milestones.size() <= 20 &&
        d.updatedAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow create: if validInquiry();
      allow get, list: if isStaff();
      allow update, delete: if false;
    }

    match /units/{unitId} {
      allow get, list: if true;
      allow create, update: if isStaff();
      allow delete: if false;
    }

    // Public construction progress: anyone can read, only active staff can publish.
    match /progress/{progressId} {
      allow get, list: if true;
      allow create, update: if isStaff() && progressId == 'current' && validProgress();
      allow delete: if false;
    }

    match /progressHistory/{day} {
      allow get, list: if true;
      allow create, update: if isStaff() && validProgressHistory(day);
      allow delete: if false;
    }

    match /staff/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
